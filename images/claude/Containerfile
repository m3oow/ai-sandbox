# Claude Code dans la sandbox
FROM localhost/ai-sandbox-base:latest

ARG CLIENT_VERSION=latest
# Registre npm : hérité de l'image de base (~/.npmrc). Ce paramètre ne sert
# qu'à le surcharger lors d'un build manuel (--build-arg NPM_REGISTRY=...).
ARG NPM_REGISTRY=""
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi \
 && echo "Installation depuis $(npm config get registry)" \
 && npm install -g @anthropic-ai/claude-code@${CLIENT_VERSION} \
 && claude --version

# Configuration de Claude (réglages, historique, état) propre à chaque conteneur.
# settings.json y est recopié depuis Windows à chaque lancement par ai-sandbox.ps1.
ENV CLAUDE_CONFIG_DIR=/home/dev/.claude-config
RUN mkdir -p /home/dev/.claude-config

LABEL ai-sandbox.client=claude
